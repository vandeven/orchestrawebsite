# Text files are stored with LF in the repository and checked out with LF, on every computer.
* text=auto eol=lf

# Binary files are never converted
*.pdf binary
*.png binary
*.jpg binary
*.zip binary
*.jar binary
*.woff2 binary
*.ico binary

# Windows command files need CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
